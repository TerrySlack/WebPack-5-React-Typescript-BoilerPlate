{
  "name": "weather-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint --ext 'mjs,js,jsx,ts,tsx' --max-warnings=0 --fix",
    "lint-staged": "lint-staged",
    "prepare-husky": "husky",
    "prep": "yarn && yarn prepare-husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint-staged && git add --all"
    }
  },
  "lint-staged": {
    "*.(ts|tsx)": [
      "eslint --max-warnings=0 --fix --ignore-pattern \"!/.storybook\"",
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "deep-equal": "^2.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.4.1",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-redux": "^7.1.34",
    "@types/react-test-renderer": "^19.1.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "add": "^2.0.9",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-table": "^7.32.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom-testing-mocks": "^1.16.0",
    "lint-staged": "^17.3.0",
    "oxc-transform-react": "^0.145.0",
    "postcss": "^8.5.26",
    "postcss-easings": "^4.0.0",
    "postcss-preset-env": "^11.4.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "redux-mock-store": "^1.5.5",
    "storybook": "10.5.10",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "yarn": "^1.22.22"
  },
  "jest": {
    "coverageDirectory": "dist/test-results",
    "setupFilesAfterEnv": [
      "<rootDir>/stories/setupTests.js"
    ],
    "transform": {
      "\\.(js|ts|tsx)": "ts-jest",
      ".svg": "<rootDir>/__mocks__/mockModule.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "testRegex": "(/test/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^Assets/(.*)$": "<rootDir>/src/shared/assets/$1",
      "^Components/(.*)$": "<rootDir>/src/shared/components/$1",
      "^Containers/(.*)$": "<rootDir>/src/shared/containers/$1",
      "^Hooks/(.*)$": "<rootDir>/src/shared/hooks/$1",
      "^Providers/(.*)$": "<rootDir>/src/shared/providers/$1",
      "^Selectors/(.*)$": "<rootDir>/src/shared/selectors/$1",
      "^Store/(.*)$": "<rootDir>/src/shared/store/$1",
      "^Utils/(.*)$": "<rootDir>/src/shared/utils/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 4,
        "functions": 4,
        "lines": 4,
        "statements": 4
      }
    }
  }
}
